# Postgres (Supabase). DB_URL is used by the app (pooler, IPv4).
# DIRECT_DB_URL is only used to run migrations from your machine.
DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Cloudflare R2 (S3 API). S3_URL = endpoint + bucket name as the path.
S3_URL=https://<account_id>.r2.cloudflarestorage.com/<bucket>
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API only: browser origins allowed to call the API directly. Needed only when the UI
# and API run on different ports (local dev without nginx). Leave empty behind nginx.
CORS_ORIGINS=http://localhost:8501

# UI only. API_URL: how the Streamlit server reaches the API.
# PUBLIC_API_URL: how the browser upload widget reaches the API
# (behind nginx this is just /api).
API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
